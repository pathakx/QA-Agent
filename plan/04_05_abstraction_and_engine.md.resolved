## 5.1 Playwright Execution Engine — Browser Pool

```python
# backend/automation/browser_pool.py
import asyncio
import time
from typing import Dict, Optional
from dataclasses import dataclass, field
from playwright.async_api import async_playwright, Browser, Playwright

@dataclass
class BrowserSlot:
    browser: Browser
    browser_id: str
    context_count: int = 0
    created_at: float = field(default_factory=time.time)
    last_used: float = field(default_factory=time.time)

class BrowserPoolManager:
    """
    Production-grade browser pool for Playwright.
    
    Features:
    - Configurable max concurrent browsers
    - Automatic recycling after N contexts
    - Idle timeout cleanup
    - Health monitoring
    - Graceful shutdown
    """

    def __init__(
        self,
        max_browsers: int = 3,
        max_contexts_per_browser: int = 20,
        idle_timeout_seconds: int = 300,
        browser_type: str = "chromium",
        headless: bool = True,
    ):
        self._max_browsers = max_browsers
        self._max_contexts = max_contexts_per_browser
        self._idle_timeout = idle_timeout_seconds
        self._browser_type = browser_type
        self._headless = headless

        self._slots: Dict[str, BrowserSlot] = {}
        self._semaphore = asyncio.Semaphore(max_browsers)
        self._playwright: Optional[Playwright] = None
        self._lock = asyncio.Lock()
        self._cleanup_task: Optional[asyncio.Task] = None
        self._counter = 0

    async def start(self):
        """Initialize Playwright and start cleanup loop."""
        self._playwright = await async_playwright().start()
        self._cleanup_task = asyncio.create_task(self._cleanup_loop())

    async def acquire(self) -> tuple[str, Browser]:
        """Acquire a browser from the pool. Blocks if pool is full."""
        await self._semaphore.acquire()

        async with self._lock:
            # Find reusable slot
            for slot_id, slot in self._slots.items():
                if slot.context_count < self._max_contexts and slot.browser.is_connected():
                    slot.context_count += 1
                    slot.last_used = time.time()
                    return slot_id, slot.browser

            # Launch new browser
            return await self._launch_new()

    async def release(self, browser_id: str):
        """Release browser back to pool."""
        self._semaphore.release()
        async with self._lock:
            slot = self._slots.get(browser_id)
            if slot and slot.context_count >= self._max_contexts:
                await self._recycle(browser_id)

    async def _launch_new(self) -> tuple[str, Browser]:
        launcher = getattr(self._playwright, self._browser_type)
        browser = await launcher.launch(
            headless=self._headless,
            args=["--disable-dev-shm-usage", "--disable-gpu", "--no-sandbox"]
        )
        self._counter += 1
        browser_id = f"browser-{self._counter}"
        self._slots[browser_id] = BrowserSlot(
            browser=browser, browser_id=browser_id, context_count=1
        )
        return browser_id, browser

    async def _recycle(self, browser_id: str):
        slot = self._slots.pop(browser_id, None)
        if slot and slot.browser.is_connected():
            await slot.browser.close()

    async def _cleanup_loop(self):
        """Periodically close idle browsers."""
        while True:
            await asyncio.sleep(60)
            async with self._lock:
                now = time.time()
                idle_ids = [
                    bid for bid, slot in self._slots.items()
                    if now - slot.last_used > self._idle_timeout
                ]
                for bid in idle_ids:
                    await self._recycle(bid)

    async def shutdown(self):
        """Gracefully close all browsers."""
        if self._cleanup_task:
            self._cleanup_task.cancel()
        async with self._lock:
            for slot in list(self._slots.values()):
                if slot.browser.is_connected():
                    await slot.browser.close()
            self._slots.clear()
        if self._playwright:
            await self._playwright.stop()
```

## 5.2 ArtifactManager

```python
# backend/automation/artifact_manager.py
import os
import time
from typing import Optional, Dict

class ArtifactManager:
    """Manages test execution artifacts: screenshots, videos, traces."""

    BASE_DIR = "test_results"

    @staticmethod
    def get_artifact_dir(test_id: str, artifact_type: str = "") -> str:
        path = os.path.join(ArtifactManager.BASE_DIR, test_id, artifact_type)
        os.makedirs(path, exist_ok=True)
        return path

    @staticmethod
    async def save_screenshot(page, test_id: str, suffix: str = "failure") -> Optional[str]:
        try:
            dir_path = ArtifactManager.get_artifact_dir(test_id, "screenshots")
            timestamp = int(time.time())
            filepath = os.path.join(dir_path, f"{suffix}_{timestamp}.png")
            await page.screenshot(path=filepath, full_page=True)
            return filepath
        except Exception as e:
            print(f"[ARTIFACT] Screenshot failed: {e}")
            return None

    @staticmethod
    def get_video_dir(test_id: str) -> str:
        return ArtifactManager.get_artifact_dir(test_id, "videos")

    @staticmethod
    def get_trace_dir(test_id: str) -> str:
        return ArtifactManager.get_artifact_dir(test_id, "traces")

    @staticmethod
    def cleanup_old_artifacts(max_age_days: int = 7):
        """Remove artifacts older than max_age_days."""
        import shutil
        cutoff = time.time() - (max_age_days * 86400)
        if not os.path.exists(ArtifactManager.BASE_DIR):
            return
        for test_dir in os.listdir(ArtifactManager.BASE_DIR):
            full_path = os.path.join(ArtifactManager.BASE_DIR, test_dir)
            if os.path.isdir(full_path) and os.path.getmtime(full_path) < cutoff:
                shutil.rmtree(full_path, ignore_errors=True)
```

## 5.3 Modified Execution Service (Engine-Agnostic)

```python
# backend/services/execution_service.py (REFACTORED)
import time
import asyncio
from typing import Optional
from backend.automation.base_driver import ExecutionResult, BrowserConfig
from backend.automation.driver_factory import DriverFactory
from backend.automation.artifact_manager import ArtifactManager

async def execute_test_with_driver(
    script_content: str,
    test_id: str,
    engine: str = None,
    config: BrowserConfig = None
) -> ExecutionResult:
    """
    Execute a test using the abstraction layer.
    
    For AI-generated scripts that use raw Playwright/Selenium API directly
    (subprocess model), use execute_test_script() instead.
    
    For structured test steps (future), use this function.
    """
    start_time = time.time()
    driver = None

    try:
        config = config or BrowserConfig(
            record_video=True,
            record_trace=True,
            video_dir=ArtifactManager.get_video_dir(test_id),
            trace_dir=ArtifactManager.get_trace_dir(test_id)
        )

        driver = await DriverFactory.create(engine=engine, config=config)
        ctx = await driver.create_context(config)
        browser_info = await driver.get_browser_info()

        # Execute the script content
        # This would require a safe execution sandbox
        # For now, we still use subprocess for AI-generated scripts
        
        duration = time.time() - start_time
        artifacts = await ctx.close()

        return ExecutionResult(
            status="passed",
            logs="",
            duration=duration,
            video_path=artifacts.get("video_path"),
            trace_path=artifacts.get("trace_path"),
            browser=browser_info.get("browser"),
            browser_version=browser_info.get("version"),
            os_info=browser_info.get("os")
        )

    except Exception as e:
        duration = time.time() - start_time
        return ExecutionResult(
            status="failed",
            logs=str(e),
            duration=duration,
            error_message=str(e)
        )

    finally:
        if driver:
            await driver.shutdown()
```

## 5.4 Execution Flow Diagram

```mermaid
sequenceDiagram
    participant WF as LangGraph Workflow
    participant ES as ExecutionService
    participant DF as DriverFactory
    participant PD as PlaywrightDriver
    participant BP as BrowserPool
    participant CTX as ExecutionContext
    participant AM as ArtifactManager
    participant DB as Supabase

    WF->>ES: execute_test_script(content, test_id)
    ES->>DF: create(engine="playwright")
    DF->>PD: PlaywrightDriver()
    PD->>BP: acquire()
    BP-->>PD: (browser_id, browser)
    PD-->>ES: driver

    ES->>AM: get_video_dir(test_id)
    AM-->>ES: path
    ES->>PD: create_context(config)
    PD->>CTX: new BrowserContext + Page

    ES->>CTX: navigate(url)
    ES->>CTX: fill(selector, value)
    ES->>CTX: click(selector)

    alt Success
        ES->>CTX: screenshot(path)
        ES->>CTX: close()
        CTX-->>ES: {video_path, trace_path}
    else Failure
        ES->>AM: save_screenshot(page, test_id)
        ES->>CTX: close()
        CTX-->>ES: {video_path, trace_path}
    end

    ES->>PD: release browser to pool
    PD->>BP: release(browser_id)
    ES-->>WF: ExecutionResult
    WF->>DB: Update test_executions
```
